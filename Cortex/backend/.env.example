# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/cortex

# Polymarket APIs
POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API_URL=https://clob.polymarket.com

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Database pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# External Services — add your keys in the app: /profile → API Keys
# Required: tavily + at least one LLM provider (openrouter, google, groq, nvidia, etc.)
